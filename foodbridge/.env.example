# ---- Backend (role: API / data) ----
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/foodbridge
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
AUDIT_API_KEY=change-me
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters
DEMO_MODE=false

# OSRM uses https://router.project-osrm.org by default. Public routing shares
# route coordinates only after a one-time consent in the live-map panel.
# Set OSRM_BASE_URL to use a self-hosted API proxy instead.
# OSRM_BASE_URL=http://127.0.0.1:5000/
# NOMINATIM_BASE_URL=http://127.0.0.1:8080/
# MAP_TILES_BASE_URL=http://127.0.0.1:8081/tile/

# ---- Game client (role: gameplay) ----
VITE_API_URL=http://localhost:4000   # game only; the portal uses the Vite proxy

# ---- Web portal (role: dashboard) ----
# VITE_API_URL is shared; set it in each package's own .env if needed
# OpenStreetMap tiles are used by default. Override with a compatible tile URL,
# or use /api/map/tiles/{z}/{x}/{y} with MAP_TILES_BASE_URL configured above.
# VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional direct browser OSRM override. Leave unset to use the API's OSRM_BASE_URL.
# VITE_OSRM_BASE_URL=https://router.project-osrm.org/

# ---- Community audit (role: field data sync) ----
FOODBRIDGE_API_URL=http://localhost:4000
AUDIT_API_KEY=change-me
