{
  "services": {
    "backend": {
      "root": "foodbridge/backend",
      "framework": "express"
    },
    "game-client": {
      "root": "foodbridge/game-client",
      "framework": "vite"
    },
    "web-portal": {
      "root": "foodbridge/web-portal",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/game",
      "destination": {
        "service": "game-client"
      }
    },
    {
      "source": "/game/(.*)",
      "destination": {
        "service": "game-client"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web-portal"
      }
    }
  ]
}